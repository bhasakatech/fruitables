<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                jcr:title="Header Configuration"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <logo
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Logo"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <logoImage
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Logo Image"
                                        name="./logoImage"/>
                                    <logoText
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Logo Text (Fallback)"
                                        name="./logoText"
                                        value="Fruitables"/>
                                </items>
                            </column>
                        </items>
                    </logo>
                    <navigation
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Navigation Menu"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <menu
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="Navigation Items">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./menu">
                                    <items jcr:primaryType="nt:unstructured">
                                        <accordion
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/accordion"
                                            margin="{Boolean}false"
                                            multiple="{Boolean}true"
                                            variant="quiet">
                                            <items jcr:primaryType="nt:unstructured">
                                                <navItem
                                                    jcr:primaryType="nt:unstructured"
                                                    jcr:title="Navigation Item"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <label
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Menu Label"
                                                            name="./label"/>
                                                        <link
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                            fieldLabel="Menu Link"
                                                            name="./link"/>
                                                        <children
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                            composite="{Boolean}true"
                                                            fieldLabel="Dropdown Items">
                                                            <field
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                                                name="./children">
                                                                <items jcr:primaryType="nt:unstructured">
                                                                    <accordion
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/accordion"
                                                                        margin="{Boolean}false"
                                                                        multiple="{Boolean}true"
                                                                        variant="quiet">
                                                                        <items jcr:primaryType="nt:unstructured">
                                                                            <dropdownItem
                                                                                jcr:primaryType="nt:unstructured"
                                                                                jcr:title="Dropdown Item"
                                                                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                                                                <items jcr:primaryType="nt:unstructured">
                                                                                    <childLabel
                                                                                        jcr:primaryType="nt:unstructured"
                                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                                        fieldLabel="Dropdown Label"
                                                                                        name="./childLabel"/>
                                                                                    <childLink
                                                                                        jcr:primaryType="nt:unstructured"
                                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                                        fieldLabel="Dropdown Link"
                                                                                        name="./childLink"/>
                                                                                </items>
                                                                            </dropdownItem>
                                                                        </items>
                                                                    </accordion>
                                                                </items>
                                                            </field>
                                                        </children>
                                                    </items>
                                                </navItem>
                                            </items>
                                        </accordion>
                                    </items>
                                </field>
                            </menu>
                        </items>
                    </navigation>
                    <icons
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Action Icons"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <enableSearch
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="{Boolean}true"
                                        fieldLabel="Enable Search Icon"
                                        name="./enableSearch"
                                        text="Show search icon"
                                        uncheckedValue="false"
                                        value="true"/>
                                    <enableCart
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="{Boolean}true"
                                        fieldLabel="Enable Cart Icon"
                                        name="./enableCart"
                                        text="Show cart icon with badge"
                                        uncheckedValue="false"
                                        value="true"/>
                                    <enableProfile
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="{Boolean}true"
                                        fieldLabel="Enable Profile Icon"
                                        name="./enableProfile"
                                        text="Show profile icon"
                                        uncheckedValue="false"
                                        value="true"/>
                                    <cartPagePath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Cart Page Path"
                                        name="./cartPagePath"/>
                                    <defaultCartCount
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                        fieldLabel="Default Cart Count"
                                        min="0"
                                        name="./defaultCartCount"
                                        step="1"
                                        value="3"/>
                                </items>
                            </column>
                        </items>
                    </icons>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
