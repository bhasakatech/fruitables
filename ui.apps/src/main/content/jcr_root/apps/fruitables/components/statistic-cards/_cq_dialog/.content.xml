<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Statistics Cards"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <accordion
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/accordion"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <main
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Statistics Cards Configuration"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <statsItems
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldDescription="Add statistic cards with icon, title and value"
                                fieldLabel="Add Statistic Cards"
                                name="./statsItems">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./statsItems">
                                    <items jcr:primaryType="nt:unstructured">
                                        <accordion
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/accordion"
                                            margin="{Boolean}false"
                                            multiple="{Boolean}true"
                                            variant="quiet">
                                            <items jcr:primaryType="nt:unstructured">
                                                <statCard
                                                    jcr:primaryType="nt:unstructured"
                                                    jcr:title="Statistic Card"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        
                                                        <title
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Card Title (e.g. SATISFIED CUSTOMERS)"
                                                            name="./title"
                                                            required="{Boolean}true"/>
                                                        <value
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Value (e.g. 1963 or 99%)"
                                                            name="./value"
                                                            required="{Boolean}true"/>
                                                    </items>
                                                </statCard>
                                            </items>
                                        </accordion>
                                    </items>
                                </field>
                            </statsItems>
                        </items>
                    </main>
                </items>
            </accordion>
        </items>
    </content>
</jcr:root>