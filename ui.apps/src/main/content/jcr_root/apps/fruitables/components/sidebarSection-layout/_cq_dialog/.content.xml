<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Sidebar Section Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <fruitablesTabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <searchAndSorting
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Search &amp; Sorting"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <layoutPosition
                                granite:class="cq-dialog-dropdown-showhide"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldDescription="Choose whether the sidebar appears on the left or right side on larger screens. Right layout renders only keyword search, categories, featured products, and banner."
                                fieldLabel="Sidebar Position"
                                name="./layoutPosition">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    cq-dialog-dropdown-showhide-target=".sidebar-section-layout-dialog-target"/>
                                <items jcr:primaryType="nt:unstructured">
                                    <left
                                        jcr:primaryType="nt:unstructured"
                                        selected="{Boolean}true"
                                        text="Left"
                                        value="left"/>
                                    <right
                                        jcr:primaryType="nt:unstructured"
                                        text="Right"
                                        value="right"/>
                                </items>
                            </layoutPosition>
                            <sectionTitle
                                granite:class="hide sidebar-section-layout-dialog-target"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Section Title"
                                name="./sectionTitle"
                                value="Fresh fruits shop">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    showhidetargetvalue="left"/>
                            </sectionTitle>
                            <searchPlaceholder
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Search Placeholder"
                                name="./searchPlaceholder"
                                value="keywords"/>
                            <searchImage
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldDescription="Optional icon image. If empty, the default search icon is used."
                                fieldLabel="Search Icon Image"
                                name="./searchImage"
                                rootPath="/content/dam/fruitables"/>
                            <sortingLabel
                                granite:class="hide sidebar-section-layout-dialog-target"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Sorting Label"
                                name="./sortingLabel"
                                value="Default Sorting:">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    showhidetargetvalue="left"/>
                            </sortingLabel>
                            <sortingOptions
                                granite:class="hide sidebar-section-layout-dialog-target"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="Sorting Options">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    showhidetargetvalue="left"/>
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./sortingOptions">
                                    <items jcr:primaryType="nt:unstructured">
                                        <optionText
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Option Text"
                                            name="./optionText"/>
                                        <selected
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                            fieldLabel="Selected by Default"
                                            name="./selected"
                                            text="Select this option"
                                            uncheckedValue="false"
                                            value="true"/>
                                    </items>
                                </field>
                            </sortingOptions>
                        </items>
                    </searchAndSorting>
                    <categoryTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Categorys"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <categoryTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Category Title"
                                name="./categoryTitle"/>
                            <fragmentRootPath
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldDescription="Select the DAM folder or parent path that contains the product content fragments."
                                fieldLabel="Content Fragment Root Path"
                                name="./fragmentRootPath"
                                required="{Boolean}true"
                                rootPath="/content/dam/fruitables"/>
                            <categoryTags
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/coral/common/form/tagfield"
                                fieldDescription="These authored tags are shown as categories and used to count and filter matching products."
                                fieldLabel="Category Tags"
                                multiple="{Boolean}true"
                                name="./tags"
                                rootPath="/content/cq:tags"/>
                        </items>
                    </categoryTab>
                    <categoryDisplayTab
                        granite:class="hide sidebar-section-layout-dialog-target"
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Category Display"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="left"/>
                        <items jcr:primaryType="nt:unstructured">
                            <cartButtonText
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Cart Button Text"
                                name="./cartButtonText"/>
                            <cardStyle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Card Style"
                                name="./cardStyle">
                                <items jcr:primaryType="nt:unstructured">
                                    <standard
                                        jcr:primaryType="nt:unstructured"
                                        text="Standard"
                                        value="standard"/>
                                    <compact
                                        jcr:primaryType="nt:unstructured"
                                        text="Compact"
                                        value="compact"/>
                                </items>
                            </cardStyle>
                            <priceUnit
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Price Unit"
                                name="./priceUnit"/>
                            <showDescription
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                checked="{Boolean}true"
                                name="./showDescription"
                                text="Show Description"
                                uncheckedValue="false"
                                value="true"/>
                            <showRating
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                checked="{Boolean}true"
                                name="./showRating"
                                text="Show Rating"
                                uncheckedValue="false"
                                value="true"/>
                            <showCategory
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                checked="{Boolean}true"
                                name="./showCategory"
                                text="Show Category Badge"
                                uncheckedValue="false"
                                value="true"/>
                            <showBorder
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                name="./showBorder"
                                text="Show Card Border"
                                uncheckedValue="false"
                                value="true"/>
                            <categoryColor
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Category Badge Color"
                                name="./categoryColor">
                                <items jcr:primaryType="nt:unstructured">
                                    <orange
                                        jcr:primaryType="nt:unstructured"
                                        text="Orange"
                                        value="orange"/>
                                    <green
                                        jcr:primaryType="nt:unstructured"
                                        text="Green"
                                        value="green"/>
                                    <blue
                                        jcr:primaryType="nt:unstructured"
                                        text="Blue"
                                        value="blue"/>
                                </items>
                            </categoryColor>
                            <badgePosition
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Category Badge Position"
                                name="./badgePosition">
                                <items jcr:primaryType="nt:unstructured">
                                    <topLeft
                                        jcr:primaryType="nt:unstructured"
                                        text="Top Left"
                                        value="top-left"/>
                                    <topRight
                                        jcr:primaryType="nt:unstructured"
                                        text="Top Right"
                                        value="top-right"/>
                                    <bottomLeft
                                        jcr:primaryType="nt:unstructured"
                                        text="Bottom Left"
                                        value="bottom-left"/>
                                    <bottomRight
                                        jcr:primaryType="nt:unstructured"
                                        text="Bottom Right"
                                        value="bottom-right"/>
                                </items>
                            </badgePosition>
                        </items>
                    </categoryDisplayTab>
                    <price
                        granite:class="hide sidebar-section-layout-dialog-target"
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Price"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="left"/>
                        <items jcr:primaryType="nt:unstructured">
                            <priceTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Price Title"
                                name="./priceTitle"
                                value="Price"/>
                            <minPrice
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Minimum Price"
                                min="0"
                                name="./minPrice"
                                step="1"
                                value="0"/>
                            <maxPrice
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Maximum Price"
                                min="0"
                                name="./maxPrice"
                                step="1"
                                value="500"/>
                            <selectedPrice
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Default Selected Price"
                                min="0"
                                name="./selectedPrice"
                                step="1"
                                value="0"/>
                        </items>
                    </price>
                    <additional
                        granite:class="hide sidebar-section-layout-dialog-target"
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Additional"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="left"/>
                        <items jcr:primaryType="nt:unstructured">
                            <additionalTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Additional Title"
                                name="./additionalTitle"
                                value="Additional"/>
                            <additionalOptions
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="Radio Options">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./additionalOptions">
                                    <items jcr:primaryType="nt:unstructured">
                                        <label
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Label"
                                            name="./label"/>
                                        <checked
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                            fieldLabel="Checked by Default"
                                            name="./checked"
                                            text="Select this radio option"
                                            uncheckedValue="false"
                                            value="true"/>
                                    </items>
                                </field>
                            </additionalOptions>
                        </items>
                    </additional>
                    <featuredProducts
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Featured Products"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <featuredProductsTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Featured Products Title"
                                name="./featuredProductsTitle"
                                value="Featured products"/>
                            <products
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="Products">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/accordion"
                                    name="./products">
                                    <items jcr:primaryType="nt:unstructured">
                                        <item
                                            jcr:primaryType="nt:unstructured"
                                            jcr:title="Product"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                            <items jcr:primaryType="nt:unstructured">
                                                <cfPath
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    fieldLabel="Content Fragment Path"
                                                    name="./cfPath"
                                                    required="{Boolean}true"
                                                    rootPath="/content/dam/fruitables"/>
                                                <cardStyle
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                    fieldLabel="Card Style"
                                                    name="./cardStyle">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <compact
                                                            jcr:primaryType="nt:unstructured"
                                                            text="Compact"
                                                            value="compact"/>
                                                        <standard
                                                            jcr:primaryType="nt:unstructured"
                                                            text="Standard"
                                                            value="standard"/>
                                                    </items>
                                                </cardStyle>
                                            </items>
                                        </item>
                                    </items>
                                </field>
                            </products>
                            <viewMoreLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="View More Button Label"
                                name="./viewMoreLabel"
                                value="View More"/>
                        </items>
                    </featuredProducts>
                    <banner
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Banner"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <bannerImage
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Banner Image"
                                name="./bannerImage"
                                rootPath="/content/dam/fruitables"/>
                            <bannerTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                fieldDescription="Example: Fresh Fruits Banner"
                                fieldLabel="Banner Text"
                                name="./bannerTitle"
                                useFixedInlineToolbar="{Boolean}true"
                                value="Fresh Fruits Banner"/>
                        </items>
                    </banner>
                </items>
            </fruitablesTabs>
        </items>
    </content>
</jcr:root>
